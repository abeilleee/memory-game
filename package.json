    "stylelint": "^17.15.0",
    "vite": "^8.3.0"
  },
  "lint-staged": {
    "*.{css,scss}": "stylelint --fix",
    "*.{ts,js,tsx,jsx}": "eslint --fix",
    "*.{ts,js,tsx,jsx,json,scss,css,md}": "prettier --write"
  }
